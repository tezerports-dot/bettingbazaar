{
  "name": "betting-bazaar",
  "version": "4.0.0",
  "type": "module",
  "description": "Betting Bazaar platform",
  "scripts": {
    "dev": "npm --prefix user-panel run dev",
    "build": "npm run build:user && npm run build:admin && npm run build:merchant",
    "install:panels": "npm --prefix user-panel ci --legacy-peer-deps && npm --prefix admin-panel ci --legacy-peer-deps && npm --prefix merchant-panel ci --legacy-peer-deps",
    "build:user": "npm --prefix user-panel run build",
    "build:admin": "npm --prefix admin-panel run build",
    "build:merchant": "npm --prefix merchant-panel run build",
    "preview": "npm --prefix user-panel run preview",
    "start": "node backend/server.js",
    "start:local": "node --env-file=.env backend/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "test:redis": "vitest run --config vitest.redis.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check:deps": "depcruise backend --config .dependency-cruiser.cjs",
    "check:no-mongo": "node scripts/verify-no-mongo.mjs",
    "check:balance-reads": "node scripts/audit-balance-reads.mjs",
    "check:coherence": "node scripts/verify-migration-coherence.mjs",
    "sync:indexes": "node backend/scripts/sync-indexes.mjs",
    "verify:capabilities": "node scripts/verify-capabilities.mjs",
    "migrate:public-chat-retention": "node backend/scripts/enforce-public-chat-retention.js",
    "loadtest:seed": "node loadtest/seed-accounts.mjs",
    "loadtest:bets": "k6 run loadtest/bet-contention.js",
    "loadtest:realtime": "node loadtest/realtime-connections.mjs",
    "stack:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "stack:down": "docker compose -f docker-compose.test.yml down -v",
    "stack:logs": "docker compose -f docker-compose.test.yml logs -f",
    "test:all": "sh -c 'export DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bb_test REDIS_URL=redis://127.0.0.1:6379; npm run check:no-mongo && npm run test:unit && npm run test:pg && npm run test:redis'",
    "check:db-boundary": "node scripts/verify-db-boundary.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/lib-storage": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/three": "^0.185.4",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.3.0",
    "bullmq": "^6.3.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.3",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.9.4",
    "path-to-regexp": "^8.4.2",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "qs": "^6.15.3",
    "raw-body": "^3.0.2",
    "socket.io": "^4.8.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "dependency-cruiser": "^18.2.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "betting",
    "anonymous",
    "s3",
    "vultr",
    "bunnycdn",
    "crypto"
  ],
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^4.1.2",
    "fast-xml-builder": "^1.2.1",
    "fast-xml-parser": "^5.10.1",
    "form-data": "^4.0.6",
    "ip-address": "^10.4.0",
    "js-yaml": "^5.2.2",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.5",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.25",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "mongodb-memory-server@11.2.0": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.1": true
  },
  "imports": {
    "#db/*": "./database/*"
  }
}
