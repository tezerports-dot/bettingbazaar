{
  "name": "betting-bazaar",
  "version": "4.0.0",
  "type": "module",
  "description": "Betting Bazaar platform",
  "scripts": {
    "dev": "npm --prefix user-panel run dev",
    "build": "npm run build:user && npm run build:admin && npm run build:merchant",
    "install:panels": "npm --prefix user-panel ci --legacy-peer-deps && npm --prefix admin-panel ci --legacy-peer-deps && npm --prefix merchant-panel ci --legacy-peer-deps",
    "build:user": "npm --prefix user-panel run build",
    "build:admin": "npm --prefix admin-panel run build",
    "build:merchant": "npm --prefix merchant-panel run build",
    "preview": "npm --prefix user-panel run preview",
    "start": "node backend/server.js",
    "start:local": "node --env-file=.env backend/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check:deps": "depcruise backend --config .dependency-cruiser.cjs",
    "reconcile:pg": "node backend/postgres/reconcile.js",
    "sync:indexes": "node backend/scripts/sync-indexes.mjs",
    "migrate:aadhaar-hashes": "node backend/scripts/migrate-aadhaar-hashes.js",
    "pg:migrate:partition": "node backend/postgres/migratePartitions.js",
    "verify:capabilities": "node scripts/verify-capabilities.mjs",
    "migrate:public-chat-retention": "node backend/scripts/enforce-public-chat-retention.js",
    "handoff:frontends": "node scripts/create-frontend-handoffs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/lib-storage": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^8.18.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/three": "^0.185.1",
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.3.0",
    "bullmq": "^5.80.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^11.18.2",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.408.0",
    "mongoose": "^8.0.3",
    "nodemailer": "^9.0.3",
    "path-to-regexp": "^8.4.2",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "qs": "^6.15.3",
    "raw-body": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^18.2.0",
    "react-router": "^7.18.1",
    "react-router-dom": "^7.18.1",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "three": "^0.185.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "ipaddr.js": "^1.9.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.2",
    "dependency-cruiser": "^18.1.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.19",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^40.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "terser": "^5.49.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "betting",
    "anonymous",
    "s3",
    "vultr",
    "bunnycdn",
    "crypto"
  ],
  "overrides": {
    "@babel/core": "7.29.7",
    "fast-uri": "^3.1.4",
    "fast-xml-parser": "^5.10.1",
    "fast-xml-builder": "^1.2.1",
    "form-data": "^4.0.6",
    "js-yaml": "^5.2.1",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.5",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "mongodb-memory-server@11.2.0": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.1": true
  }
}
