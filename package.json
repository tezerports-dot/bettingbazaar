{
  "name": "betting-bazaar",
  "version": "4.0.0",
  "type": "module",
  "description": "Betting Bazaar platform",
  "scripts": {
    "dev": "vite",
    "build": "npm install && cd admin-panel && npm install && npm run build && cd ../merchant-panel && npm install && npm run build && cd ..",
    "build:user": "vite build",
    "build:admin": "cd admin-panel && npm install && npx vite build && cd ..",
    "build:merchant": "cd merchant-panel && npm install && npx vite build && cd ..",
    "preview": "vite preview",
    "start": "node backend/server.js",
    "start:local": "node --env-file=.env backend/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check:deps": "depcruise backend --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.621.0",
    "@aws-sdk/s3-request-presigner": "^3.621.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/three": "^0.167.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "framer-motion": "^11.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.408.0",
    "mongoose": "^8.0.3",
    "nodemailer": "^9.0.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^6.22.0",
    "react-router-dom": "^6.22.0",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.6.1",
    "three": "^0.167.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "dependency-cruiser": "^18.1.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.35",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "terser": "^5.27.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "betting",
    "anonymous",
    "s3",
    "vultr",
    "bunnycdn",
    "crypto"
  ]
}
