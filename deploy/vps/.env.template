# ══════════════════════════════════════════════════════════════════════════════
# FILL THIS IN, SAVE IT AS  .env  IN THIS SAME FOLDER
#
#   cp .env.template .env && nano .env
#   chmod 600 .env
#
# Every value marked FILL IN must be replaced. The app refuses to start if any
# required value is missing, weak, or still a placeholder — that is a feature.
# A platform that boots with a guessable signing key is worse than one that
# refuses to boot.
#
# Generate every secret with this command (run it once per secret, never reuse):
#
#     openssl rand -base64 48
#
# FORMATTING RULES — these matter, Docker reads this file literally:
#   · No spaces around the = sign.
#   · No quotes needed, and do not add them.
#   · Never write a # comment on the same line as a value. The text after the #
#     can end up inside the value.
#
# NEVER commit this file. NEVER paste it into a chat, an email, or a support
# ticket. Anyone holding JWT_SECRET can mint a valid admin session.
# ══════════════════════════════════════════════════════════════════════════════


# ══ 1. YOUR DOMAINS ═══════════════════════════════════════════════════════════

# FILL IN — every domain this site answers on, SPACE separated, no https://
# Each one's DNS A record must ALREADY point at this server, or its certificate
# request fails and holds up the others.
# Every domain here must ALSO be in ALLOWED_ORIGINS (section 2) as https://…,
# or sign-in and every other button that sends data fails on that domain.
SITE_ADDRESS=example.com www.example.com

# RECOMMENDED — the one name the admin panel answers on, e.g. a random-looking
# subdomain like ops-7k2q.example.com. Point its DNS A record at this server;
# its certificate is taken on first visit (no need to add it to SITE_ADDRESS).
# With it set, /admin on every other domain answers 404. Leave empty to keep
# the admin panel at /admin on every domain.
# Note: certificate logs are public, so the name can be found by anyone who
# looks it up; it keeps the panel off the player and standby domains, and the
# password and authenticator are still what protect it.
ADMIN_HOST=

# RECOMMENDED — the one name the merchant panel answers on, e.g. another
# random-looking subdomain like desk-9m4t.example.com. Same as ADMIN_HOST: point
# its DNS A record at this server and the certificate is taken on first visit.
# With it set, /merchant on every other domain answers 404 and Telegram's
# Verify sends merchants back to this name. Leave empty to keep the merchant
# panel at /merchant on every domain.
MERCHANT_HOST=

# FILL IN — a real inbox. Let's Encrypt emails certificate warnings here.
ACME_EMAIL=you@example.com


# ══ 2. PUBLIC ADDRESSES THE APP ADVERTISES ════════════════════════════════════
# Must be https:// and must match a domain above. The app refuses to start in
# production if these are http:// or malformed.

# FILL IN
PUBLIC_APP_ORIGIN=https://example.com

# FILL IN
APP_BASE_URL=https://example.com

# FILL IN — which website addresses may talk to the API. Comma separated, no
# spaces, no trailing slash. These are BROWSER addresses, the pages people
# load. Do not put an API-only URL here.
# https://localhost is the Android app: it runs at that origin INSIDE the phone
# (Capacitor). Keep it while you ship the APK — without it every request the
# app makes is refused, and production refuses to boot with ANDROID_PACKAGE_ID
# set and this origin missing.
ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://localhost


# ══ 3. SECRETS ════════════════════════════════════════════════════════════════
# Run `openssl rand -base64 48` once for EACH line below. Do not reuse a value
# across two lines — they protect different things, and sharing them means one
# leak compromises both.

# FILL IN — signs every login session. Leaking this lets anyone forge an admin.
JWT_SECRET=

# FILL IN — signs payment orders so amounts cannot be tampered with.
ORDER_HMAC_SECRET=

# FILL IN — protects the metrics endpoint from public reading.
METRICS_TOKEN=

# FILL IN — encrypts the saved Telegram bot token and game-provider keys.
# Different command: it must be exactly 32 bytes.   openssl rand -base64 32
# The server refuses to start without it. Back it up: lose it and the saved
# bot token can no longer be read (you would re-enter it in the admin panel).
IDENTITY_ENCRYPTION_KEY=


# FILL IN — database password. Any long random string; you never type it by hand.
POSTGRES_PASSWORD=

POSTGRES_USER=bb
POSTGRES_DB=bettingbazaar


# ══ 4. FILE STORAGE — CLOUDFLARE R2 ═══════════════════════════════════════════
# Holds chat attachments, payment proofs, branding images and Android APKs.
# REQUIRED: the app deliberately refuses to start in production without it,
# rather than writing them to a disk that is not backed up.
# Create a bucket and an API token at dash.cloudflare.com → R2. Then, on the
# bucket's Settings page:
#   · Public access → turn on the r2.dev URL (or connect a custom domain), and
#     put that address in CDN_URL below.
#   · CORS policy → allow PUT and GET from your site's https:// addresses
#     (browsers upload straight to the bucket; without this every upload fails).

# FILL IN — replace <ACCOUNT_ID> with your Cloudflare account ID
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

S3_REGION=auto

# FILL IN — the bucket name you created
S3_BUCKET_NAME=bettingbazaar

# FILL IN — from the R2 API token
S3_ACCESS_KEY=

# FILL IN — from the R2 API token
S3_SECRET_KEY=

# FILL IN — the bucket's public address, https:// and no trailing slash, e.g.
# https://pub-0123456789abcdef.r2.dev . Every uploaded file's link is built on
# it, so the app refuses to start without it.
CDN_URL=


# ══ 5. FIRST ADMIN LOGIN ══════════════════════════════════════════════════════
# Creates the first admin account on first boot only.
# CHANGE THE PASSWORD AND ENROL 2FA THE MOMENT YOU FIRST LOG IN. Then blank
# these two lines and restart — they are not needed again.

# FILL IN — 10-digit mobile number, no country code
DEFAULT_ADMIN_MOBILE=9999999999

# FILL IN — a strong temporary password
DEFAULT_ADMIN_PASSWORD=


# ══ 6. ALERTS — set this BEFORE launch, not after an incident ═════════════════
# A Slack or Discord incoming-webhook URL. Money-path problems (a ledger
# mismatch, a settlement failure) are sent here. Left blank, nothing tells you.
ALERT_WEBHOOK_URL=



# ══ 6b. CAPTCHA (required) ═══════════════════════════════════════════════════
# FILL IN — the Cloudflare Turnstile SECRET key (the panels carry the site key).
# Without it the server REFUSES TO BOOT, because the captcha on signup and
# login would otherwise pass every request. To run without a captcha on
# purpose, leave it empty and uncomment ALLOW_NO_CAPTCHA=true instead.
TURNSTILE_SECRET_KEY=
# ALLOW_NO_CAPTCHA=true

# FILL IN — the matching Turnstile SITE key (the public half). It is built into
# the player website when the image is built, so after changing it rebuild:
# docker compose -f docker-compose.prod.yml up -d --build
VITE_TURNSTILE_SITE_KEY=

# ══ 6b2. WHEN A DOMAIN IS BLOCKED ═════════════════════════════════════════════
# docs/governance/DOMAIN_FAILOVER.md. All three are PUBLIC; the private signing
# key never comes near this server. The signed file itself goes at
# deploy/vps/gateway/gateway.json (mounted read-only into the app).
# The public key the signed gateway document must verify against:
GATEWAY_CONFIG_PUBLIC_KEY=
# The same key and the mirror URLs (npm run gateway-publish -- urls), built into
# the player website so it and the installed web app can move off a blocked
# address. Rebuild after changing: docker compose -f docker-compose.prod.yml up -d --build
VITE_GATEWAY_CONFIG_PUBLIC_KEY=
VITE_GATEWAY_CONFIG_URLS=


# ══ 6c. ANDROID APP ══════════════════════════════════════════════════════════
# The package the APK ships as — must equal appId in user-panel/capacitor.config.ts.
# Setting it also makes production require https://localhost in ALLOWED_ORIGINS
# (section 2), and every APK uploaded on the admin Android App page is checked
# against it.
ANDROID_PACKAGE_ID=com.bettingbazaar.app

# FILL IN — the SHA-256 of your release signing key, printed by
# scripts/android/create-signing-key.sh (docs/governance/ANDROID_RELEASE_SETUP.md).
# Two jobs: /.well-known/assetlinks.json names it so links to the site open the app,
# and the admin Android App page refuses an upload signed with any other key.
ANDROID_SHA256_CERT_FINGERPRINTS=


# ══ 7. LEAVE THESE ALONE ══════════════════════════════════════════════════════
# Set correctly by docker-compose.prod.yml. Listed only so nothing looks missing:
#   NODE_ENV, DATABASE_URL, REDIS_URL, PG_SSL, TRUST_PROXY,
#   BB_RUNTIME_ROLE, PORT, UV_THREADPOOL_SIZE
#
#   DIRECT_DATABASE_URL, BB_SCHEMA_APPLY, BB_WORKERS, PGBOUNCER_STATS_URL
#
# Optional, once a SECOND domain is live and pointing here. The app's own
# build settings (VITE_API_BACKUP_URL, VITE_API_ALLOWED_HOSTS) decide where it
# may fail over to; this list decides which of those hosts Admin > Settings >
# API Host may send apps to (docs/governance/ENV.md, "Endpoint discovery"):
# API_ALLOWED_HOSTS=api.example.com,api-backup.example.net
