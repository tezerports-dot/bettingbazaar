# GOVERNANCE: Read CLAUDE.md before editing this file.
# ══════════════════════════════════════════════════════════════════════════════
# VPS edge — automatic HTTPS + routing to the two serving roles.
#
# Distinct from the repository-root Caddyfile, which serves `:{$PORT}`
# host-agnostically for a PaaS that terminates TLS for you. This one owns TLS
# itself, because on your own VPS nothing else will.
#
# SITE_ADDRESS carries every domain this deployment answers on, space separated:
#
#     SITE_ADDRESS="bettingbazaar.com www.bettingbazaar.com bettingbazaar.vip"
#
# Caddy obtains and renews a certificate for each one automatically, provided
# its DNS A record already points at this server. A domain whose DNS is not
# ready yet will fail issuance and hold up the others — add it after DNS
# propagates, not before.
#
# STANDBY hosts are not listed here. They are the hosts of the gateway document
# signed offline (docs/governance/DOMAIN_FAILOVER.md), and Caddy takes their
# certificate the first time a visitor reaches one (`on_demand_tls`), after
# asking the api role whether the name is served here
# (GET /api/v1/client/tls-allowed). So putting a standby live is one DNS record
# pointed at this server: no edit here, no restart, and a stranger's name
# pointed at this address gets no certificate.
#
# Multi-domain is plain redundancy: every hostname serves the same app, the same
# routes, the same behaviour (backend/config/network.config.js). Nothing here
# takes client IP, geo or ISP as an input, and no per-domain logic exists —
# that constraint is deliberate and load-bearing (CLAUDE.md §20).
# ══════════════════════════════════════════════════════════════════════════════

{
	email {$ACME_EMAIL}
	# Standby hosts: a certificate on first use, only for a name the api role
	# says this deployment serves (config/servedHosts.js).
	on_demand_tls {
		ask http://api:8080/api/v1/client/tls-allowed
	}
	# Uncomment to rehearse against Let's Encrypt staging. Do this if you are
	# unsure about DNS: the production endpoint rate-limits failed issuance to
	# 5 per hostname per hour, and hitting that costs you the launch window.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Everything a site answers, shared by the listed domains and the standby pool.
(app_routes) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin"
		# The merchant panel scans cash QRs with the camera; nothing uses the rest.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-Via
	}

	# ── WebSocket → realtime role ────────────────────────────────────────────
	# The long timeout is not optional. socket.io pings every 25s with a 60s
	# timeout, and a proxy's usual 60s read timeout severs the connection right
	# at that boundary — producing intermittent drops that read as an app bug.
	handle /socket.io/* {
		reverse_proxy realtime:8080 {
			transport http {
				read_timeout 24h
				write_timeout 24h
			}
		}
	}

	# ── SSE (public, player, admin + merchant streams) → realtime role ──────
	# The player app's ONLY live connection (it opens no socket since
	# 2026-10-10), so this is where the audience's connections land.
	# flush_interval -1 disables response buffering. Without it Caddy holds
	# events in a buffer and the boards and the admin queue appear frozen until
	# something else forces a flush.
	handle /api/sse/* {
		reverse_proxy realtime:8080 {
			flush_interval -1
			transport http {
				read_timeout 24h
			}
		}
	}

	# ── Prometheus metrics — bearer-protected in the app, still not public ────
	handle /metrics {
		respond 404
	}

	# ── The certificate question is Caddy's alone ────────────────────────────
	# on_demand_tls asks api:8080 directly (global options); from outside it
	# would only tell a stranger which names are standbys.
	handle /api/v1/client/tls-allowed {
		respond 404
	}

	# ── Everything else → api role ───────────────────────────────────────────
	# The api role serves the REST API *and* the three panel bundles
	# (/, /admin/, /merchant/), so this single route covers all of them.
	handle {
		reverse_proxy api:8080
	}
}

{$SITE_ADDRESS} {
	import app_routes
}

# Plain HTTP on any name or the bare IP: only a redirect to HTTPS, without the
# Server header Caddy's automatic redirect sends. A name with no certificate
# (the bare IP, a stranger's domain) then gets no HTTPS answer at all. ACME's
# HTTP challenge is still answered by Caddy before this block.
http:// {
	header -Server
	redir https://{host}{uri} 308
}

# Any other name: the standby pool. Caddy asks the api role first (above), and
# a name it refuses gets no certificate and no answer.
https:// {
	tls {
		on_demand
	}
	import app_routes
}
