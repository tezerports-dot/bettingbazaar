# ─────────────────────────────────────────────────────────────────────────────
# Betting Bazaar — Admin Panel (Command Center) environment
# Copy to `.env` (or set these in your host, e.g. Railway) before building.
# All platform business config (limits, cycle timing, branding, payment
# gateways, etc.) is edited at runtime from the admin UI — see System Settings
# and Branding. These VITE_* values only wire the panel to its backend/build.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API origin (no trailing slash).
# REQUIRED in production. When the admin panel is served same-origin behind the
# unified Caddy/Nginx proxy you may leave this blank; on localhost it defaults
# to http://localhost:8080. Used for both REST (/api/...) and SSE endpoints.
VITE_API_URL=http://localhost:8080

# Optional explicit realtime/websocket origin. Leave blank to reuse VITE_API_URL.
VITE_WS_URL=

# Optional: version string shown in the UI (falls back to package.json version).
VITE_APP_VERSION=
