<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      allowBackup / dataExtractionRules: OFF. The default (true) would copy this
      app's WebView storage — which holds the live session token — into the
      user's Google Drive backup, and clone a logged-in session onto a new
      device during transfer. fullBackupContent covers pre-12 devices,
      dataExtractionRules covers 12+.

      usesCleartextTraffic / networkSecurityConfig: every request must be TLS,
      enforced by the OS rather than by app code.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              App Link: a link to the public site opens THIS app, not a browser.

              What it carries today is the password-reset link. There is no
              player email, so a forgotten password is recovered through the
              bot, which sends `https://<host>/#/reset/<token>`
              (passwordReset.service.js). With this filter the tap opens the
              installed app on its reset screen; without it the reset still
              works — in a browser — and the player then signs in to the app
              with the new password. So this is the difference between a
              smooth recovery and a detour, not between working and broken.
              (Signing in itself is a form with a password; §33.)

              ── Why the path is exactly "/" ──────────────────────────────────
              The token rides in the FRAGMENT, deliberately: it never reaches an
              access log or a Referer header. Intent filters cannot match a
              fragment; Android matches Uri.getPath(), which for
              `https://host/#/reset/…` is just "/". So "/" is the narrowest
              thing that can be matched, and it is enough: it captures the site
              root and therefore every HashRouter route, while leaving
              `/merchant`, `/admin`, `/api/…` and the `/r/<code>` referral
              redirects to the browser — none of which this package renders.

              ── autoVerify ───────────────────────────────────────────────────
              Makes this a VERIFIED App Link: no "open with" chooser, and no
              other installed app can claim the URL. It requires the origin to
              serve /.well-known/assetlinks.json naming this package and its
              signing certificate — backend/routes/wellKnown.routes.js does that
              from ANDROID_PACKAGE_ID + ANDROID_SHA256_CERT_FINGERPRINTS. Unset,
              the file 404s, verification fails, and links open a browser.

              ── appLinkHost ─────────────────────────────────────────────────
              Supplied at build time from ANDROID_APP_ORIGIN (app/build.gradle):
              the PUBLIC_APP_ORIGIN host the bot builds its links against.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${appLinkHost}"
                    android:path="/" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The in-app updater (ApkUpdaterPlugin) hands a downloaded, hash-verified
      APK to Android's installer. Android still asks the player to confirm, and
      the first time asks them to allow this app to install updates at all.
      NOTE: Google Play forbids this permission for apps it distributes (Play
      updates them itself). This APK is distributed directly; a Play build
      would remove this line and the plugin together.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
