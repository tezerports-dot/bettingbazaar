<?xml version="1.0" encoding="utf-8"?>
<!--
  GOVERNANCE: Read CLAUDE.md before editing this file.

  Every window this app shows before the web bundle paints is the brand's dark
  background (@color/brand_background, generated by scripts/generate-icons.mjs
  from the same value as manifest.json's theme_color). The template left these
  on the light theme's white, so a dark app opened on a white flash.
-->
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- What BridgeActivity switches to in onCreate: the window behind the WebView. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/brand_background</item>
    </style>

    <!--
      The launch theme. Before Android 12 the window background IS the splash
      (@drawable/splash, density-picked). From Android 12 the system draws its
      own splash — the launcher icon over windowSplashScreenBackground — and
      the default for that is the light theme's white, not the drawable.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
