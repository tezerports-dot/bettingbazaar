# GOVERNANCE: Read CLAUDE.md before editing this file.
#
# Build-time configuration for the PLAYER panel (user-panel).
#
# Vite inlines every VITE_* value into the bundle at build time. Two
# consequences, both load-bearing:
#
#   1. Nothing here is a secret. It ships inside the JavaScript every visitor
#      downloads. Never put a token, key or password in this file — the
#      backend's own .env at the repository root is where secrets live.
#   2. Changing any of these means REBUILDING. There is no runtime override.
#      An APK in particular carries whatever was set when it was built, so a
#      wrong value is fixed by a new build, not by a server restart.
#
# Copy to `.env` (gitignored) and fill in for your deployment.

# ── Where the backend is ────────────────────────────────────────────────────
# OPTIONAL for a normal web deploy: when the panel and the API are served from
# the same host, leave it empty and the panel calls a relative `/api`.
#
# MANDATORY for the Android build. Inside the Capacitor shell the page is served
# from https://localhost, so a relative path asks the HANDSET for the API and
# every request fails — while the app installs, opens and renders perfectly.
# `npm run build:native` refuses to build without it (scripts/assert-native-env.mjs).
#
# Origin only: no trailing slash, and no /api suffix (the client appends it).
VITE_API_URL=

# ONE backup origin serving the SAME deployment (an https hostname: a second
# load balancer or CDN name — never an IP address). Used when the primary stops
# answering (services/originFailover.ts). Optional.
VITE_API_BACKUP_URL=

# Endpoint discovery (optional). During the loading screen the app GETs this
# https URL, expects {"url": "https://api.example.com"} and accepts the answer
# ONLY if its host is the primary's, the backup's, or listed below (exact
# hostnames, no wildcards, no IPs). The answer can never add a host. If
# discovery fails the app tries the primary, then the backup, then shows a
# "Can't connect / Try again" screen. Serve nothing secret from it.
VITE_API_DISCOVERY_URL=
VITE_API_ALLOWED_HOSTS=

# ── The public origin of the site itself ────────────────────────────────────
# MANDATORY for the Android build; unused on the web.
#
# This is the origin the bot builds sign-in links against — the backend's
# PUBLIC_APP_ORIGIN, and it must match. Two things depend on it:
#   - the shell decides which incoming deep links to trust (services/nativeDeepLink.ts)
#   - its HOST is baked into the APK's App Link intent-filter at build time
#     (passed to Gradle as -PappLinkHost by the release workflow)
#
# Player auth is Telegram-only and that link is the only door, so an APK built
# with this wrong or unset is an APK nobody can sign in to. Origin only, no path.
VITE_APP_ORIGIN=

# ── Cross-panel link ────────────────────────────────────────────────────────
# Where /merchant links point. Optional for a single-service deploy, where the
# merchant panel is served from the same host under /merchant.
VITE_MERCHANT_PANEL_URL=

# ── Bot mitigation ──────────────────────────────────────────────────────────
# Cloudflare Turnstile SITE key (the public half — the secret half is
# TURNSTILE_SECRET_KEY on the backend). The captcha gate is a pass-through until
# BOTH are set. See docs/PROJECT_STATUS.md §3.3.
VITE_TURNSTILE_SITE_KEY=

# ── Version ─────────────────────────────────────────────────────────────────
# Do NOT set this by hand. It is injected at build time from package.json
# (CLAUDE.md §2 forbids a version literal in any source file).
# VITE_APP_VERSION=
