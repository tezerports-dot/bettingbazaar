+        await Merchant.findByIdAndUpdate(order.merchantId, {
+          $inc: { tokenBalance: -order.tokenAmount },
+        }).catch(e => console.error('[dispute resolve] tokenBalance decrement:', e.message));
+      }
+
+      order.status            = 'COMPLETED';
