+// ── UPI QR Generator ───────────────────────────────────────────────────────────
+function UpiQrCode({ intentString }: { intentString: string }) {
+  const [qrDataUrl, setQrDataUrl] = useState<string>('');
+
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
