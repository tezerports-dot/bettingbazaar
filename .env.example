# ════════════════════════════════════════════════════════════════════════════
# 🔧 BETTING BAZAAR — ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env for local dev. In Railway: set via Variables tab.
# Assessment Issue #3: S3/CDN vars must be set or uploads will fail silently.
# ════════════════════════════════════════════════════════════════════════════

# ── SERVER ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
# Graceful shutdown windows (AQ-4). On SIGTERM the app fails readiness, waits
# DRAIN ms for the load balancer to stop sending traffic, then closes the
# listener and drains in-flight work; DEADLINE ms is the absolute backstop
# before a forced exit (covers long-lived SSE connections).
# SHUTDOWN_DRAIN_MS=5000
# SHUTDOWN_DEADLINE_MS=25000
# Public base URL of this deployment (used in share links, email CTAs, etc.)
APP_BASE_URL=https://your-domain.example
# Log verbosity: error | warn | info | debug  (default info in production)
LOG_LEVEL=info
# AQ-10: max request-body size for normal routes (default 1mb). The admin
# base64 asset upload uses its own larger limit (ASSET_JSON_LIMIT, default 8mb).
# JSON_BODY_LIMIT=1mb
# ASSET_JSON_LIMIT=8mb

# ── DATABASE ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bettingbazaar
# Connection pool sizing per instance (tune against your DB tier's budget)
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
# AQ-14: index builds happen at boot by default (safe — the unique indexes are
# money-path idempotency gates). To avoid boot-time index builds on a scaled
# fleet, set MONGO_AUTO_INDEX=false AND run `npm run sync:indexes` in your
# deploy pipeline. Do NOT disable it without running that script on a fresh DB.
# MONGO_AUTO_INDEX=false

# ── AUTH & CRYPTO SECRETS (generate strong random values — rotate before launch)
# REQUIRED: the app refuses to start in production without JWT_SECRET,
# ORDER_HMAC_SECRET, and MONGODB_URI (startup/validateEnv.js, AQ-1).
JWT_SECRET=change-this-to-a-64-char-random-string
# Access-token lifetime (AQ-2 / decision D-4 default is 24h; instant revocation
# is retained via the TokenBlacklist). Env overrides the default.
JWT_EXPIRES_IN=24h
# JWT issuer/audience stamped on every token (AQ-2). Leave as-is unless you run
# multiple issuers. Set JWT_ENFORCE_CLAIMS=true to REQUIRE iss/aud on verify —
# only after every pre-AQ-2 token (no iss/aud) has expired (i.e. > JWT_EXPIRES_IN
# after deploying AQ-2). Until then, leave it unset so legacy tokens still work.
# JWT_ISSUER=bettingbazaar
# JWT_AUDIENCE=bettingbazaar
# JWT_ENFORCE_CLAIMS=true
# HMAC secret for order-integrity signing (payment order tamper protection)
ORDER_HMAC_SECRET=change-this-to-a-random-string
# First-boot admin bootstrap (change the password immediately after first login)
DEFAULT_ADMIN_MOBILE=9999999999
DEFAULT_ADMIN_PASSWORD=change-this-strong-password

# ── REDIS (Railway managed or external) ─────────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list. For Railway: https://yourapp.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── S3 STORAGE (Vultr Object Storage — see ANONYMOUS-COMPLETE-SETUP-GUIDE.md)
# ⚠️  REQUIRED for file uploads. Without these, upload endpoints return 500.
# Assessment Issue #3: This was missing from original deployment — add to Railway!
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY=your-vultr-access-key
S3_SECRET_KEY=your-vultr-secret-key

# ── CDN (Bunny.net — see ANONYMOUS-COMPLETE-SETUP-GUIDE.md) ──────────────────
# ⚠️  REQUIRED for CDN URL generation. Without this, cdnUrl will be undefined.
CDN_URL=https://yourzone.b-cdn.net

# ── EMAIL CHANNEL (Phase E — Communication Platform, optional) ──────────────
# Set these and the EMAIL notification channel goes live (any SMTP provider:
# SES, Postmark, Brevo, ...). Leave unset and email stays declared-inactive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Betting Bazaar <no-reply@your-domain.example>"

# ── FRONTEND PANELS (only if panels are deployed SEPARATELY from the backend)
# When served from the same origin (default single-service deploy), leave these
# blank — the panels fall back to same-origin '/api'.
VITE_API_URL=
# Websocket URL (if different from API URL)
VITE_WS_URL=

# ── 58-item plan additions (2026-07-13) ──────────────────────────────────────
# Hybrid money DB (plan items 6/10/11): set to activate the Postgres layer
# (schema auto-applies; money writes dual-write; reconcile with `npm run reconcile:pg`).
# DATABASE_URL=postgresql://user:pass@host:5432/bettingbazaar
# Money-DB TLS (AQ-3): the DEFAULT is VERIFIED TLS against the system trust store.
#   PG_SSL=false        → no TLS (local/plaintext Postgres only)
#   PG_CA_CERT=<PEM>    → verified TLS pinned to the provider's CA (recommended
#                         for managed Postgres that publishes a CA bundle)
#   PG_SSL=no-verify    → TLS WITHOUT certificate verification (escape hatch;
#                         loudly warned every boot — avoid in production)
# PG_SSL=false
# Operational alerting (item 38) — bootstrap fallback; prefer the admin UI field.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Prometheus scrape auth (item 33): if set, GET /metrics requires this Bearer token.
# METRICS_TOKEN=
# Automated backups (item 45): how many daily archives to keep in S3 (default 14).
# BACKUP_KEEP=14
# Multi-domain (item 29): comma-separated hostnames this deploy serves; optional
# canonical host to 301-normalize the rest to (leave unset for equal peers).
# DOMAINS=bettingbazaar.com,bettingbazaar.vip
# CANONICAL_HOST=bettingbazaar.com
# SMS channel (item 53): generic HTTP gateway — {mobile}/{message} placeholders.
# SMS_API_URL=https://api.provider.com/send?to={mobile}&text={message}
# SMS_API_METHOD=POST
# SMS_API_HEADERS={"authkey":"..."}
# SMS_BODY_TEMPLATE={"to":"{mobile}","text":"{message}"}
# WAF request filter (item 24, opt-in after watching logs for false positives):
# FEATURE_WAF_FILTER=true
