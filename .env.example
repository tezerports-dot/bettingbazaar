# ════════════════════════════════════════════════════════════════════════════
# 🔧 BETTING BAZAAR — ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env for local dev. In Railway: set via Variables tab.
# Assessment Issue #3: S3/CDN vars must be set or uploads will fail silently.
# ════════════════════════════════════════════════════════════════════════════

# ── SERVER ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
# Graceful shutdown windows (AQ-4). On SIGTERM the app fails readiness, waits
# DRAIN ms for the load balancer to stop sending traffic, then closes the
# listener and drains in-flight work; DEADLINE ms is the absolute backstop
# before a forced exit (covers long-lived SSE connections).
# SHUTDOWN_DRAIN_MS=5000
# SHUTDOWN_DEADLINE_MS=25000
# Public base URL of this deployment (used in share links, email CTAs, etc.)
APP_BASE_URL=https://your-domain.example
# Log verbosity: error | warn | info | debug  (default info in production)
LOG_LEVEL=info
# AQ-10: max request-body size for normal routes (default 1mb). The admin
# base64 asset upload uses its own larger limit (ASSET_JSON_LIMIT, default 8mb).
# JSON_BODY_LIMIT=1mb
# ASSET_JSON_LIMIT=8mb
# Trust proxy controls Express req.ip parsing. Default is false/direct for
# portable deployments. Set TRUST_PROXY=1 only when a trusted reverse proxy such
# as Caddy is actually in front of this process.
# TRUST_PROXY=false
# Optional Core Infrastructure Architecture listener mode. Enable only when the
# Node listener is directly behind HAProxy/LB instances that prepend PROXY
# protocol v2, and restrict accepted prefaces to the internal edge subnet.
# PROXY_PROTOCOL_V2=false
# PROXY_PROTOCOL_TRUSTED_SUBNETS=10.0.10.0/24,127.0.0.1/32
# Standard outbound HTTP policy. The central NetworkClient uses Node's default
# connection pool; this project intentionally has no proxy or TLS-impersonation
# settings.
# OUTBOUND_HTTP_TIMEOUT_MS=10000
# OUTBOUND_HTTP_USER_AGENT=BettingBazaar/1.0

# ── DATABASE ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bettingbazaar
# Connection pool sizing per instance (tune against your DB tier's budget)
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
# AQ-14: index builds happen at boot by default (safe — the unique indexes are
# money-path idempotency gates). To avoid boot-time index builds on a scaled
# fleet, set MONGO_AUTO_INDEX=false AND run `npm run sync:indexes` in your
# deploy pipeline. Do NOT disable it without running that script on a fresh DB.
# MONGO_AUTO_INDEX=false

# ── AUTH & CRYPTO SECRETS (generate strong random values — rotate before launch)
# REQUIRED: the app refuses to start in production without JWT_SECRET and
# MONGODB_URI (startup/validateEnv.js, AQ-1). ORDER_HMAC_SECRET is strongly
# advised (key separation) but falls back to JWT_SECRET if unset.
JWT_SECRET=change-this-to-a-64-char-random-string
# Access-token lifetime (AQ-2 / decision D-4 default is 24h; instant revocation
# is retained via the TokenBlacklist). Env overrides the default.
JWT_EXPIRES_IN=24h
# JWT issuer/audience stamped on every token (AQ-2). Leave as-is unless you run
# multiple issuers. Set JWT_ENFORCE_CLAIMS=true to REQUIRE iss/aud on verify —
# only after every pre-AQ-2 token (no iss/aud) has expired (i.e. > JWT_EXPIRES_IN
# after deploying AQ-2). Until then, leave it unset so legacy tokens still work.
# JWT_ISSUER=bettingbazaar
# JWT_AUDIENCE=bettingbazaar
# JWT_ENFORCE_CLAIMS=true
# Secret rotation (CAP-60, zero-downtime): comma-separated OLD signing secrets,
# still ACCEPTED on verify while their tokens age out (paseto.util.js derives each
# one's Ed25519 public key and adds it to the verify set). To rotate: move the
# current JWT_SECRET here, set a new JWT_SECRET, deploy; after JWT_EXPIRES_IN has
# elapsed, remove the old secret from this list. PASETO_PREVIOUS_SECRETS is an
# equivalent alias. Unset = single-key (no change).
# JWT_PREVIOUS_SECRETS=
# HMAC secret for order-integrity signing (payment order tamper protection).
# Rotate like the others: move the active value to ORDER_HMAC_PREVIOUS_SECRETS
# (comma-separated) and set a new ORDER_HMAC_SECRET; in-flight orders signed under
# the old secret keep verifying until they complete/expire, then drop the old value.
ORDER_HMAC_SECRET=change-this-to-a-random-string
# ORDER_HMAC_PREVIOUS_SECRETS=
# Aadhaar duplicate-detection HMAC. Rotate by moving the active value to
# AADHAAR_HMAC_PREVIOUS_SECRETS (comma-separated) before setting a new value.
AADHAAR_HMAC_SECRET=change-this-to-a-dedicated-random-string
# AADHAAR_HMAC_PREVIOUS_SECRETS=
# First-boot admin bootstrap (change the password immediately after first login)
DEFAULT_ADMIN_MOBILE=9999999999
DEFAULT_ADMIN_PASSWORD=change-this-strong-password
# AQ-8: password hashing is Argon2id (OWASP/NIST first choice). Defaults follow
# the OWASP minimum (19 MiB / t=2 / p=1); raise on capable hardware. Legacy
# bcrypt hashes still verify and upgrade to argon2id on next login.
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# ── REDIS (Railway managed or external) ─────────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list. For Railway: https://yourapp.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── S3 STORAGE (Vultr Object Storage — see deploy/README.md)
# ⚠️  REQUIRED for file uploads. Without these, upload endpoints return 500.
# Assessment Issue #3: This was missing from original deployment — add to Railway!
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY=your-vultr-access-key
S3_SECRET_KEY=your-vultr-secret-key

# ── CDN (Bunny.net — see deploy/README.md) ───────────────────────────────────
# ⚠️  REQUIRED for CDN URL generation. Without this, cdnUrl will be undefined.
# This CDN is for PUBLIC assets only: branding, chat attachments, payment
# screenshots, profile pictures. Identity documents must never go here — see
# the block below.
CDN_URL=https://yourzone.b-cdn.net

# ── KYC DOCUMENTS (private bucket — see docs/KYC_DOCUMENT_STORAGE.md) ────────
# ⚠️  REQUIRED before KYC verification works at all. This path FAILS CLOSED:
# with these unset, KYC upload and submission return 503 rather than falling
# back to the public CDN, because the fallback would publish an Aadhaar card.
#
# This must be a SEPARATE bucket from S3_BUCKET_NAME above, with public access
# DISABLED, no custom domain and no CDN binding. None of that is enforceable
# from application code — it is a property of how the bucket is created.
# Cloudflare R2 is the intended provider; any S3-compatible private bucket works.
KYC_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
KYC_S3_BUCKET=bettingbazaar-kyc-private
KYC_S3_ACCESS_KEY=
KYC_S3_SECRET_KEY=
# R2 ignores the region; the AWS SDK requires one.
KYC_S3_REGION=auto

# ── EMAIL CHANNEL (Phase E — Communication Platform, optional) ──────────────
# Set these and the EMAIL notification channel goes live (any SMTP provider:
# SES, Postmark, Brevo, ...). Leave unset and email stays declared-inactive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Betting Bazaar <no-reply@your-domain.example>"

# ── FRONTEND PANELS (only if panels are deployed SEPARATELY from the backend)
# When served from the same origin (default single-service deploy), leave these
# blank — the panels fall back to same-origin '/api'.
VITE_API_URL=
# Websocket URL (if different from API URL)
VITE_WS_URL=

# ── 58-item plan additions (2026-07-13) ──────────────────────────────────────
# Hybrid money DB (plan items 6/10/11): REQUIRED for active MongoDB + PostgreSQL
# dual-write. Schema auto-applies at boot; money writes mirror to PostgreSQL;
# reconcile with `npm run reconcile:pg`.
DATABASE_URL=postgresql://user:pass@host:5432/bettingbazaar
# Money-DB TLS (AQ-3): the DEFAULT is VERIFIED TLS against the system trust store.
#   PG_SSL=false        → no TLS (local/plaintext Postgres only)
#   PG_CA_CERT=<PEM>    → verified TLS pinned to the provider's CA (recommended
#                         for managed Postgres that publishes a CA bundle)
#   PG_SSL=no-verify    → TLS WITHOUT certificate verification (escape hatch;
#                         loudly warned every boot — avoid in production)
# PG_SSL=false
# Operational alerting (item 38) — bootstrap fallback; prefer the admin UI field.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Prometheus scrape auth (item 33): REQUIRED in production; GET /metrics requires
# this Bearer token when set.
# METRICS_TOKEN=<generate-a-random-token-at-least-32-characters>
# Automated backups (item 45): how many daily archives to keep in S3 (default 14).
# BACKUP_KEEP=14
# Multi-domain (item 29): comma-separated hostnames this deploy serves; optional
# canonical host to 301-normalize the rest to (leave unset for equal peers).
# DOMAINS=bettingbazaar.com,bettingbazaar.vip
# CANONICAL_HOST=bettingbazaar.com
# SMS channel (item 53): generic HTTP gateway — {mobile}/{message} placeholders.
# SMS_API_URL=https://api.provider.com/send?to={mobile}&text={message}
# SMS_API_METHOD=POST
# SMS_API_HEADERS={"authkey":"..."}
# SMS_BODY_TEMPLATE={"to":"{mobile}","text":"{message}"}
# WAF request filter (item 24, opt-in after watching logs for false positives):
# FEATURE_WAF_FILTER=true

# ── Identity encryption (REQUIRED) ───────────────────────────────────────────
# AES-256 key for the values that must be RECOVERABLE rather than merely
# comparable: Aadhaar numbers (the outside KYC verifier needs the actual number)
# and Telegram bot tokens (whoever holds one can speak as the platform).
# Generate with: openssl rand -base64 32
# The boot gate refuses production if this is absent or not exactly 32 bytes.
# BACK IT UP OFF THE BOX — losing it makes every stored identity unreadable.
IDENTITY_ENCRYPTION_KEY=

# Rotation. To rotate: move the CURRENT value into this list, set a new
# IDENTITY_ENCRYPTION_KEY, redeploy, then re-encrypt at leisure and drop the old
# one. Comma-separated, newest first. Decrypt-only — retired keys never encrypt,
# so a compromised key stops protecting new records the moment it is retired.
# IDENTITY_ENCRYPTION_PREVIOUS_KEYS=

# ── Telegram auth (the bot and channel are configured in the ADMIN PANEL) ────
# Tokens are NOT set here: they are stored encrypted and replaceable at runtime,
# so a suspended bot can be swapped without a deploy. These only tune behaviour.
#
# How long a cached channel-membership answer is trusted before refreshing.
# TELEGRAM_MEMBERSHIP_TTL_MS=900000
# How long a last-known "member" is honoured while Telegram is UNREACHABLE.
# Failing closed would let a Telegram outage halt betting platform-wide; failing
# open forever would silently switch the requirement off. Default 24h.
# TELEGRAM_MEMBERSHIP_GRACE_MS=86400000
# Lifetime of a one-time login link sent by the bot. Short by design — it
# travels through a chat that can be forwarded or screenshotted.
# TELEGRAM_LOGIN_TTL_MS=300000

# ── Scaling: derived cycle pools (RECOMMENDED ON FOR LAUNCH) ──────────────────
# The live bet pool can be maintained two ways. OFF (default): every real bet does
# a `$inc` on the ONE Cycle document — correct, but every concurrent bet on a
# cycle queues on that single document, and adding app servers does not raise that
# ceiling (they all queue on the same row). ON: the pool is summed from the bet
# rows themselves (an index-only aggregation, memoised to ~1 write/sec/cycle), so
# bet inserts contend with nothing. This is the single change that lifts the
# write-throughput ceiling without renting a bigger or second box. Correctness is
# identical (winner + netProfit read an exact majority recompute); the only
# trade is the live display can trail by up to ~1s, which it already does (the
# broadcast is throttled). Validate with loadtest/bet-contention.js on the real
# box, then set this. Rollback is instant: remove the line (reverts to $inc).
FEATURE_DERIVED_CYCLE_POOLS=true

# Native/public app bootstrap (required in production by startup/validateEnv.js).
# Must be HTTPS in production. PUBLIC_APP_ALLOWED_ORIGINS is comma-separated.
PUBLIC_APP_ORIGIN=https://your-domain.example
PUBLIC_APP_ALLOWED_ORIGINS=https://your-domain.example

# ── Android App Links: what lets the APK be signed in to ────────────────────
# Player auth is Telegram-only. The bot sends a one-time link at
# PUBLIC_APP_ORIGIN and whichever context opens it spends the token, so if
# Android does not route that tap to the installed app, the browser takes the
# session and the app stays signed out with no way back.
#
# These two values are what /.well-known/assetlinks.json is built from
# (backend/routes/wellKnown.routes.js). Until BOTH are set that file 404s,
# verification fails, and the app captures no links. Nothing else breaks.
#
# ANDROID_PACKAGE_ID must equal the appId in user-panel/capacitor.config.ts.
ANDROID_PACKAGE_ID=com.bettingbazaar.app
# SHA-256 signing certificate fingerprints, comma-separated. Get the upload one
# from your keystore:
#   keytool -list -v -keystore upload-keystore.jks -alias bettingbazaar-upload
# Colons and case do not matter — the route normalises either form.
#
# LIST BOTH when you publish on Play. Play App Signing re-signs the APK with
# Google's key before any user installs it, so a site naming only the upload
# fingerprint verifies for sideloaded builds and fails for every store install.
# The Play-held fingerprint is in Play Console → Setup → App signing.
ANDROID_SHA256_CERT_FINGERPRINTS=
# Optional: advertised by GET /api/app/bootstrap. No iOS client exists —
# see docs/governance/NATIVE_APP_DISTRIBUTION_POLICY.md.
IOS_BUNDLE_ID=
