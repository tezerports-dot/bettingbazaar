# ══════════════════════════════════════════════════════════════════════════════
# UNIFIED CADDYFILE — optional edge: static panels + reverse-proxied backend
# ══════════════════════════════════════════════════════════════════════════════
#
# This is the safe hybrid TLS setup for this Node app:
#   Caddy terminates TLS and proxies to Node, while Node enforces the
#   admin-managed JA3 policy from System Settings.
#
# Stock Caddy does not randomize client JA3 and does not expose a built-in JA3
# placeholder. If you need inbound JA3 enforcement, run a trusted edge component
# that computes the client fingerprint and forwards X-TLS-JA3-Hash / X-TLS-JA3,
# then set TLS_FINGERPRINT_EDGE_SECRET in both Caddy and Node so clients cannot
# spoof those headers. Do NOT use residential/anti-detect proxy rotation here;
# this edge is for defensive observation and policy enforcement.
#
# Routing:
#   /api/*, /socket.io/*, /health*, /metrics, /app-assets/*, /storage/*
#                → Node backend ({$BACKEND_UPSTREAM}, default localhost:8080)
#   /admin/*     → admin-panel/dist   (SPA)
#   /merchant/*  → merchant-panel/dist (SPA)
#   /*           → dist                (user panel SPA)
# ══════════════════════════════════════════════════════════════════════════════

:{$PORT}

encode zstd gzip

header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
}

@backend path /api/* /socket.io/* /health* /metrics /app-assets/* /storage/*
handle @backend {
    reverse_proxy {$BACKEND_UPSTREAM:localhost:8080} {
        # Trust gate for TLS fingerprint headers. Node only accepts forwarded
        # JA3 headers when this secret matches TLS_FINGERPRINT_EDGE_SECRET.
        header_up X-Edge-Fingerprint-Secret {$TLS_FINGERPRINT_EDGE_SECRET:}

        # Never pass client-supplied fingerprint headers through as-is. A
        # trusted JA3-capable Caddy module/sidecar must set
        # {http.vars.trusted_ja3_hash} from the TLS ClientHello; this variable
        # is the only JA3 source forwarded to Node.
        header_up -X-TLS-JA3-Hash
        header_up -X-TLS-JA3
        header_up -X-JA3-Hash
        header_up -X-JA3
        header_up X-JA3-Hash {http.vars.trusted_ja3_hash}

        # Static internal routing classification for upstream observability.
        # This is not client-controlled and does not alter TLS or HTTP/2.
        header_up X-Routing-Tier "default-defensive"
    }
}

handle /admin* {
    uri strip_prefix /admin
    root * /app/admin-panel/dist
    file_server
    try_files {path} /index.html
}

handle /merchant* {
    uri strip_prefix /merchant
    root * /app/merchant-panel/dist
    file_server
    try_files {path} /index.html
}

handle {
    root * /app/dist
    file_server
    try_files {path} /index.html
}
